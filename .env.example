# Copy to .env (never commit .env). See docs/TESTNET.md.

# Your testnet parent account, created with the NEAR CLI faucet command in docs/TESTNET.md.
PARENT_ACCOUNT=hivebuy.testnet

# Optional: the parent's private key. Leave empty to read it from
# %USERPROFILE%\.near-credentials\testnet\<PARENT_ACCOUNT>.json (written by NEAR CLI).
PARENT_PRIVATE_KEY=

# Token for escrow: "test" (deploys tUSDC under your parent) or "circle" (Circle testnet USDC).
TOKEN=test

# Agents created by setup.
BUYERS=5
SELLERS=3

# Seconds per phase (join, commit, reveal) in a live round.
PHASE_SECS=30

# Optional RPC overrides.
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# NEAR_MAINNET_RPC_URL=https://free.rpc.fastnear.com
